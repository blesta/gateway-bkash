<?php
/**
 * bKash Gateway Settings Template (Admin View).
 *
 * This template is loaded by Bkash::getSettings() inside the Blesta Admin Portal
 * (Settings > Company > Payment Gateways > Installed > bKash > Manage).
 *
 * @var View $this Blesta View instance
 * @var array $meta Array of current gateway settings from database
 */
?>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Bkash.app_key', true), 'app_key', ['class' => 'form-label']);
    $this->Form->fieldText('app_key', ($meta['app_key'] ?? null), ['id' => 'app_key', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Bkash.app_secret', true), 'app_secret', ['class' => 'form-label']);
    $this->Form->fieldPassword('app_secret', [
        'id' => 'app_secret',
        'class' => 'form-control',
        'value' => ($meta['app_secret'] ?? null),
        'autocomplete' => 'new-password'
    ]);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Bkash.username', true), 'username', ['class' => 'form-label']);
    $this->Form->fieldText('username', ($meta['username'] ?? null), ['id' => 'username', 'class' => 'form-control']);
    ?>
</div>
<div class="mb-3">
    <?php
    $this->Form->label($this->_('Bkash.password', true), 'password', ['class' => 'form-label']);
    $this->Form->fieldPassword('password', [
        'id' => 'password',
        'class' => 'form-control',
        'value' => ($meta['password'] ?? null),
        'autocomplete' => 'new-password'
    ]);
    ?>
</div>
<div class="form-check">
    <?php
    $this->Form->fieldCheckbox(
        'sandbox',
        'true',
        (($meta['sandbox'] ?? 'true') === 'true'),
        ['id' => 'sandbox', 'class' => 'form-check-input']
    );
    $this->Form->label($this->_('Bkash.sandbox', true), 'sandbox', ['class' => 'form-check-label']);
    ?>
    <div class="form-text"><?php $this->_('Bkash.settings.mode_note'); ?></div>
</div>
