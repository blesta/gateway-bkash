<?php
/**
 * bKash Payment Process View (Client Invoice Checkout View).
 *
 * This template is loaded by Bkash::buildProcess() or Bkash::errorPage() when a client
 * pays an invoice using the bKash payment method.
 *
 * VIEW STATES:
 *  1. Error State ($error_message):
 *     Renders an alert displaying a localized error message if the invoice
 *     amount is invalid, the currency is not BDT, or the gateway failed to initialize.
 *  2. Checkout Redirect State ($checkout_url):
 *     Renders the payment button. Clicking this button redirects the client's
 *     browser to the bKash hosted portal (bkashURL) to complete payment.
 *
 * Uses only markup shared by Bootstrap 4 and 5 so it renders in every client theme.
 *
 * @var View $this Blesta View instance
 * @var string|null $error_message Localized error message to display
 * @var string|null $checkout_url The bKash payment portal URL (from bKash /create API)
 */
?>
<?php if (!empty($error_message)) { ?>
    <div class="alert alert-danger" role="alert"><?php echo $this->Html->safe($error_message); ?></div>
<?php } elseif (!empty($checkout_url)) { ?>
    <a id="bkash-pay-btn" href="<?php echo $this->Html->safe($checkout_url); ?>" class="btn btn-primary">
        <?php $this->_('Bkash.buildprocess.submit'); ?>
    </a>
<?php } ?>
